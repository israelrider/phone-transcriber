# Copy this file to .env and fill in your values.
# The .env file is never committed to version control.

# ── Ollama Cloud credentials ───────────────────────────────────────────────
# Your Ollama Cloud API key (found at https://cloud.ollama.com → Settings → API Keys)
OPENAI_API_KEY=ollama_xxxxxxxxxxxxxxxxxxxxxxxx

# Ollama Cloud base URL (do not change unless self-hosting)
OPENAI_BASE_URL=https://cloud.ollama.com

# Model to use for transcript cleanup.
# Recommended for Hebrew: llama3.1:8b, mistral:7b, qwen2.5:7b
OPENAI_MODEL=llama3.1:8b

# ── Optional ──────────────────────────────────────────────────────────────
# Override the default Whisper model (tiny/base/small/medium/large/large-v2/large-v3)
# WHISPER_MODEL=medium
